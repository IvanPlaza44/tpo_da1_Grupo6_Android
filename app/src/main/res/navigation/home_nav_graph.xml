<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.myapplication.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_publicarFragment"
            app:destination="@id/product_nav_graph" />

        <action
            android:id="@+id/action_homeFragment_to_misPublicacionesFragment"
            app:destination="@id/misPublicacionesFragment" />

        <action
            android:id="@+id/action_homeFragment_to_explorarFragment"
            app:destination="@id/explorarFragment" />

        <action
            android:id="@+id/action_homeFragment_to_favoritosFragment"
            app:destination="@id/favoritosFragment" />

        <action
            android:id="@+id/action_homeFragment_to_busquedasGuardadasFragment"
            app:destination="@id/busquedasGuardadasFragment" />

        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profile_nav_graph" />

    </fragment>


    <fragment
        android:id="@+id/misPublicacionesFragment"
        android:name="com.example.myapplication.ui.product.MisPublicacionesFragment"
        android:label="Mis Publicaciones"
        tools:layout="@layout/fragment_mis_publicaciones" />

    <fragment
        android:id="@+id/explorarFragment"
        android:name="com.example.myapplication.ui.explorar.ExplorarFragment"
        android:label="Explorar"
        tools:layout="@layout/fragment_explorar">

        <argument
            android:name="aplicarBusquedaGuardada"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="query"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="estadoArticulo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="zona"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <action
            android:id="@+id/action_explorarFragment_to_publicacionDetalleFragment"
            app:destination="@id/publicacionDetalleFragment" />

    </fragment>

    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.myapplication.ui.favoritos.FavoritosFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_favoritos">

        <action
            android:id="@+id/action_favoritosFragment_to_publicacionDetalleFragment"
            app:destination="@id/publicacionDetalleFragment" />

    </fragment>

    <fragment
        android:id="@+id/busquedasGuardadasFragment"
        android:name="com.example.myapplication.ui.busquedas.BusquedasGuardadasFragment"
        android:label="Búsquedas guardadas"
        tools:layout="@layout/fragment_busquedas_guardadas">

        <action
            android:id="@+id/action_busquedasGuardadasFragment_to_explorarFragment"
            app:destination="@id/explorarFragment" />

    </fragment>

    <fragment
        android:id="@+id/publicacionDetalleFragment"
        android:name="com.example.myapplication.ui.detail.PublicacionDetalleFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_publicacion_detalle">
        <argument
            android:name="publicacionId"
            app:argType="long" />
    </fragment>

</navigation>
