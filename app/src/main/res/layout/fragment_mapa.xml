<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Punto de encuentro"
            android:textAppearance="@style/TextAppearance.Ronda.Headline" />

        <TextView
            android:id="@+id/tvArticulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.Ronda.BodySecondary"
            tools:text="Impresora HP Smart Tank" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:gravity="center_horizontal"
            android:text="La otra parte aceptó tu oferta. Coordinen el encuentro y, cuando se haga la entrega, marquenla para poder calificarse."
            android:textAppearance="@style/TextAppearance.Ronda.BodySecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComoLlegar"
            style="@style/Widget.Ronda.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:enabled="false"
            android:text="Cargando ubicación..."
            app:icon="@android:drawable/ic_menu_directions"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_s" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarcarEntregada"
            style="@style/Widget.Ronda.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:enabled="false"
            android:text="Marcar como entregada"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_s" />

    </LinearLayout>

</ScrollView>
