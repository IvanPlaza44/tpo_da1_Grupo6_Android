<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_m">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        android:text="Filtros"
        android:textAppearance="@style/TextAppearance.Ronda.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Categoria"
        android:textAppearance="@style/TextAppearance.Ronda.Label" />

    <Spinner
        android:id="@+id/spCategoriaFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        android:background="@drawable/bg_spinner_outline"
        android:minHeight="48dp"
        android:padding="@dimen/spacing_s" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Precio minimo"
        android:textAppearance="@style/TextAppearance.Ronda.Label" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Ronda.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        android:hint="Opcional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrecioMin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Precio maximo"
        android:textAppearance="@style/TextAppearance.Ronda.Label" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Ronda.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        android:hint="Opcional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPrecioMax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado del articulo"
        android:textAppearance="@style/TextAppearance.Ronda.Label" />

    <Spinner
        android:id="@+id/spEstadoArticuloFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_m"
        android:background="@drawable/bg_spinner_outline"
        android:minHeight="48dp"
        android:padding="@dimen/spacing_s" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zona"
        android:textAppearance="@style/TextAppearance.Ronda.Label" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Ronda.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_l"
        android:hint="Opcional">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etZonaFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimpiarFiltros"
            style="@style/Widget.Ronda.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:text="Limpiar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAplicarFiltros"
            style="@style/Widget.Ronda.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aplicar" />

    </LinearLayout>

</LinearLayout>
